<Project>
  <!-- Authoritative, tracked product identity. Build labels and Git revisions
       are deliberately separate from Windows product-version metadata. -->
  <PropertyGroup>
    <OmsiLaunchProductName>OmsiLaunch</OmsiLaunchProductName>
    <OmsiLaunchCompanyName>LMonteiro</OmsiLaunchCompanyName>
    <OmsiLaunchLegalCopyright>Copyright © 2026 LMonteiro - https://github.com/lmonteirotech/OmsiLaunch</OmsiLaunchLegalCopyright>
    <OmsiLaunchProductVersion>0.1.0-beta4</OmsiLaunchProductVersion>
    <OmsiLaunchManagedVersion>0.1.0</OmsiLaunchManagedVersion>
    <OmsiLaunchAssemblyVersion>0.1.0.0</OmsiLaunchAssemblyVersion>
    <OmsiLaunchFileVersion>0.1.0.0</OmsiLaunchFileVersion>
    <OmsiLaunchFileVersionCommas>0,1,0,0</OmsiLaunchFileVersionCommas>
    <OmsiLaunchProductComments>Runtime control, session management and integration infrastructure for OMSI 2.</OmsiLaunchProductComments>
    <OmsiLaunchPackageAlias>current</OmsiLaunchPackageAlias>
  </PropertyGroup>
</Project>
