<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net6.0-windows</TargetFramework><Platforms>x86</Platforms><PlatformTarget>x86</PlatformTarget><AllowUnsafeBlocks>true</AllowUnsafeBlocks><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles><CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies><DnneGenerateExports>true</DnneGenerateExports><DnneBuildExports>true</DnneBuildExports><DnneRuntimeIdentifier>win-x86</DnneRuntimeIdentifier><DnneNetHostDir>C:\Program Files\dotnet\packs\Microsoft.NETCore.App.Host.win-x86\6.0.36\runtimes\win-x86\native</DnneNetHostDir></PropertyGroup>
  <ItemGroup><PackageReference Include="DNNE" Version="2.0.6" /><ProjectReference Include="..\OmsiLaunch.Api\OmsiLaunch.Api.csproj" /><ProjectReference Include="..\OmsiLaunch.Interop\OmsiLaunch.Interop.csproj" /><ProjectReference Include="..\OmsiLaunch.Builds.Omsi23004\OmsiLaunch.Builds.Omsi23004.csproj" /><ProjectReference Include="..\OmsiLaunch.Runtime.Modules\OmsiLaunch.Runtime.Modules.csproj" /><None Include="OmsiLaunch.Plugin.opl" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
  <Target Name="GeneratePluginNativeIdentity" BeforeTargets="DnneBuildNativeExports">
    <PropertyGroup><_PluginIdentityDir>$(BaseIntermediateOutputPath)$(Configuration)\$(TargetFramework)\identity</_PluginIdentityDir></PropertyGroup>
    <MakeDir Directories="$(_PluginIdentityDir)" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\tools\Write-NativeIdentityHeader.ps1&quot; -IdentityFile &quot;$(MSBuildThisFileDirectory)..\..\OmsiLaunch.Version.props&quot; -OutputPath &quot;$(_PluginIdentityDir)\OmsiLaunch.Identity.h&quot;" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\tools\Invoke-ResourceCompiler.ps1&quot; -IncludeDirectory &quot;$(_PluginIdentityDir)&quot; -OutputPath &quot;$(_PluginIdentityDir)\OmsiLaunch.PluginNE.res&quot; -SourcePath &quot;$(MSBuildThisFileDirectory)OmsiLaunch.PluginNE.rc&quot;" />
    <PropertyGroup><DnneLinkerUserFlags>$(DnneLinkerUserFlags) &quot;$(_PluginIdentityDir)\OmsiLaunch.PluginNE.res&quot;</DnneLinkerUserFlags></PropertyGroup>
  </Target>
</Project>
