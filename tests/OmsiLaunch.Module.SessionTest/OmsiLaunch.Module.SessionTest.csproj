<Project Sdk="Microsoft.NET.Sdk">
  <!-- A test session program (module component kind "host"): the module tests
       start it through ModuleSessionProcess to check the stdin/stdout protocol,
       the job limits and the stop path. It is never packaged. -->
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net6.0</TargetFramework><PlatformTarget>x64</PlatformTarget><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings></PropertyGroup>
</Project>
